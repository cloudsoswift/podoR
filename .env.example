# docker-compose 용 환경변수 템플릿. 
# `.env`로 복사하여 저장한 뒤, 값을 채울 것.
#   `cp .env.example .env`

# --- PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Spring ---
# 컨테이너용 프로필. deploy 그룹(deploy_db/deploy_security)을 쓰거나
# 별도 프로필을 준비할 것.
# datasource/redis 관련 프로퍼티는 compose 의 SPRING_* env 가 덮음.
SPRING_PROFILES_ACTIVE=deploy

# --- Next.js (브라우저에서 백엔드로 가는 주소) ---
# `next build` 시점에 번들에 박히는 주소. 단일 오리진이므로 `https://<host>/api` 형태.
#   예) https://<MagicDNS>.<tail네트워크이름>.ts.net/api
NEXT_PUBLIC_API_URL=change-me

# --- Streaming ---
# MediaMTX ↔ Spring 내부 콜백 공유 비밀. URL 쿼리(?token=)로도 전달되므로 반드시 hex 로 만든다
# (base64 의 '+' 는 쿼리에서 공백으로 바뀌어 송출 허가가 전부 401 이 된다). 예) openssl rand -hex 32
STREAM_INTERNAL_TOKEN=
# 관람 쿠키(podor_media) HMAC 서명 키. 예) openssl rand -hex 32
STREAM_MEDIA_COOKIE_SECRET=
# 480p 인코더: vaapi(Intel Quick Sync) | x264(CPU)
STREAM_ENCODER=vaapi
